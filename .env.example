# ========================================================
# ORION ALGO - ENVIRONMENT VARIABLES CONFIGURATION
# ========================================================

# --------------------------------------------------------
# 1. FRONTEND / NEXT.JS (Vercel & Local .env.local)
# --------------------------------------------------------
# Supabase project URL & Anonymous/Publishable Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Python FastAPI Backend URL (Render Production URL or http://localhost:8000)
# Set this in Vercel Project Settings -> Environment Variables for live broker & engine connection
BACKEND_URL=https://your-render-backend-app.onrender.com
NEXT_PUBLIC_API_URL=https://your-render-backend-app.onrender.com

# Optional Kite Connect credentials (if using Zerodha live market stream directly)
# KITE_API_KEY=your_kite_api_key
# KITE_ACCESS_TOKEN=your_kite_access_token

# --------------------------------------------------------
# 2. BACKEND / FASTAPI (Render Environment Variables)
# --------------------------------------------------------
# CORS Origins (comma-separated or allow frontend domain)
ALLOWED_ORIGINS=https://orion-algo.vercel.app,http://localhost:3000

# Broker Credentials (Optional: can also be entered from the frontend UI Settings)
# ZERODHA_API_KEY=your_key
# ZERODHA_API_SECRET=your_secret
# ZERODHA_ACCESS_TOKEN=your_token

# --------------------------------------------------------
# 3. GITHUB ACTIONS SECRETS (Automated DB Migrations)
# Configure under: GitHub Repo -> Settings -> Secrets and variables -> Actions
# --------------------------------------------------------
# Direct or Pooled PostgreSQL connection string from Supabase:
# Settings -> Database -> Connection String -> URI (Session or Transaction pooler)
SUPABASE_DB_URL=postgresql://postgres.yourprojectid:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Alternatively, set individual variables:
# SUPABASE_PROJECT_ID=yourprojectid
# SUPABASE_DB_PASSWORD=your_db_password
# SUPABASE_REGION=aws-0-ap-south-1
